                        id: "lt_" + Date.now(),
                        title: tenChuDe,
                        grade: khoi,
                        children: ketQuaAiTatCa.ly_thuyet,
                        source: "ai",
                        date: new Date().toLocaleDateString('vi-VN')
                    });
                    safeJsonSet('danh_sach_bai_hoc_ly_thuyet', dsLyThuyet);
                    await dongBoToanCuc('danh_sach_bai_hoc_ly_thuyet');
                    daLuuMucNao = true;
                }

                let tenTracNghiem = tenChuDe.toLowerCase().includes('trắc nghiệm') ? tenChuDe : `${tenChuDe} - Trắc Nghiệm Hằng Ngày`;
                let tenBoss = tenChuDe.toLowerCase().includes('thử thách tối thượng') ? tenChuDe : `${tenChuDe} - Thử Thách Tối Thượng`;
                let tenVuotAi = tenChuDe.toLowerCase().includes('nâng cấp tư duy') ? tenChuDe : `${tenChuDe} - Nâng Cấp Tư Duy`;

                // 2. Lưu Đề trắc nghiệm
                if (Array.isArray(ketQuaAiTatCa.trac_nghiem) && ketQuaAiTatCa.trac_nghiem.length > 0) {
                    let dsDe = safeJsonParse('ngan_hang_de_trac_nghiem', []);
                    dsDe.unshift({
                        id: "bode_" + Date.now(),
                        title: tenTracNghiem,
                        level: "easy",
                        grade: khoi,
                        questions: ketQuaAiTatCa.trac_nghiem,
                        source: "ai",
                        created_at: nowStr
                    });
                    safeJsonSet('ngan_hang_de_trac_nghiem', dsDe);
                    await dongBoToanCuc('ngan_hang_de_trac_nghiem');
                    daLuuMucNao = true;
                }

                // 3. Lưu Đề Boss
                if (Array.isArray(ketQuaAiTatCa.boss) && ketQuaAiTatCa.boss.length > 0) {
                    let dsBoss = safeJsonParse('ngan_hang_de_boss', []);
                    dsBoss.unshift({
                        id: "bodeboss_" + Date.now(),
                        title: tenBoss,
                        level: "hard",
                        grade: khoi,
                        questions: ketQuaAiTatCa.boss,
                        source: "ai",
                        created_at: nowStr
                    });
                    safeJsonSet('ngan_hang_de_boss', dsBoss);
                    await dongBoToanCuc('ngan_hang_de_boss');
                    daLuuMucNao = true;
                }

                // 4. Lưu Đề Vượt ải
                if (Array.isArray(ketQuaAiTatCa.vuot_ai) && ketQuaAiTatCa.vuot_ai.length > 0) {
                    let dsVuotAi = safeJsonParse('ngan_hang_de_vuot_ai', []);
                    dsVuotAi.unshift({
                        id: "bodevuotai_" + Date.now(),
                        title: tenVuotAi,
                        grade: khoi,
                        level: "medium",
                        questions: ketQuaAiTatCa.vuot_ai,
                        source: "ai",
                        created_at: nowStr
                    });
                    safeJsonSet('ngan_hang_de_vuot_ai', dsVuotAi);
                    await dongBoToanCuc('ngan_hang_de_vuot_ai');
                    daLuuMucNao = true;
                }

                if (!daLuuMucNao) {
                    showToast("Không có mục nào để lưu!", "warning");
                    saveBtns.forEach(b => {
                        b.disabled = false;
                        b.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Lưu Tất Cả Vào Hệ Thống`;
                    });
                    return;
                }

                // Tải lại toàn bộ bảng danh sách trong admin để hiển thị dữ liệu mới
                taiDuLieuHeThongAdmin();

                saveBtns.forEach(b => {
                    b.disabled = false;
                    b.innerHTML = `<i class="fa-solid fa-check"></i> Đã Lưu Thành Công Cả 4 Mục!`;
                    b.style.backgroundColor = '#27ae60';
                });

                showToast(`🎉 Đã lưu thành công trọn bộ vào hệ thống và đồng bộ Cloud!`, "success");

                // Gợi ý xóa ảnh tạm nếu có ảnh
                if (danhSachAnhSgk.length > 0) {
                    setTimeout(() => {
                        if (confirm(`🎉 Đã nạp thành công trọn bộ vào hệ thống!\n\nThầy có muốn xóa ${danhSachAnhSgk.length} ảnh SGK vừa dùng để giải phóng bộ nhớ máy không?`)) {
                            xoaTatCaAnhGallery(true);
                            showToast("Đã giải phóng bộ nhớ ảnh SGK.", "info");
                        }
                    }, 500);
                }

            } catch(err) {
                console.error("Lỗi lưu:", err);
                saveBtns.forEach(b => {
                    b.disabled = false;
                    b.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Thử Lưu Lại`;
                });
                showToast("Lỗi khi lưu: " + err.message, "error");
            }
        };

