        //  7. XEM CHI TIẾT & CHỈNH SỬA NỘI DUNG (PREVIEW & JSON EDIT)
        // ============================================================
        function xemChiTietNoiDung(loaiKho, id) {
            const key = KHO_KEY_MAP[loaiKho];
            if (!key) return;
            const list = safeJsonParse(key, []);
            const item = list.find(x => x.id === id);

            if (!item) {
                showToast("Không tìm thấy dữ liệu để hiển thị chi tiết!", "error");
                return;
            }

            document.getElementById('preview-title').innerHTML = `<i class="fa-solid fa-eye"></i> ${item.title || '(Chưa có tên)'}`;
            const body = document.getElementById('preview-body');
            body.innerHTML = '';

            // Nếu là dạng bộ đề có mảng questions
            if (Array.isArray(item.questions)) {
                item.questions.forEach((q, idx) => {
                    const div = document.createElement('div');
                    div.className = 'preview-box';
                    
                    const answersHtml = Array.isArray(q.answers) ? q.answers.map((opt, i) => {
                        const isCorrect = (q.correct === i);
                        return `<div style="padding: 2px 0; ${isCorrect ? 'color:#2ecc71; font-weight:bold;' : ''}"><strong>${String.fromCharCode(65 + i)}.</strong> ${opt || ''}</div>`;
                    }).join('') : '';

                    div.innerHTML = `
                        <div style="margin-bottom:6px;"><strong>Câu ${idx + 1}:</strong> ${q.question || ''}</div>
                        ${q.image ? `<div><img src="${q.image}" alt="Hình ảnh câu hỏi" onerror="this.style.display='none'"></div>` : ''}
                        ${answersHtml ? `<div style="margin: 8px 0 6px 0; padding-left: 8px; border-left: 2px solid #2c3a57;">${answersHtml}</div>` : ''}
                        ${typeof q.correct === 'number' ? `<div style="color:#2ecc71; font-size:0.88rem; margin-top:4px;"><strong><i class="fa-solid fa-check"></i> Đáp án đúng:</strong> ${String.fromCharCode(65 + q.correct)}</div>` : ''}
                        ${q.explanation ? `<div style="color:#f39c12; font-size:0.88rem; margin-top:4px;"><strong><i class="fa-solid fa-lightbulb"></i> Lời giải:</strong> ${q.explanation}</div>` : ''}
                    `;
                    body.appendChild(div);
                });
            } 
            // Nếu là dạng lý thuyết có children
            else if (Array.isArray(item.children)) {
                item.children.forEach(sec => {
                    const div = document.createElement('div');
                    div.className = 'preview-box';
                    div.innerHTML = `<h4 style="color:#3498db; margin:0 0 8px 0; font-family:'Montserrat',sans-serif;">${sec.title || ''}</h4>`;
                    
                    (sec.items || []).forEach(it => {
                        if (it.type === 'formula') {
                            if (it.display) {
                                div.innerHTML += `<div style="color:#f1c40f; margin:8px 0; text-align:center;">$$${it.text}$$</div>`;
                            } else {
                                div.innerHTML += `<div style="color:#f1c40f; margin:4px 0;">$${it.text}$</div>`;
                            }
                        } else if (it.type === 'note') {
                            div.innerHTML += `<div style="color:#e67e22; margin:6px 0; background:rgba(230,126,34,0.1); padding:6px 10px; border-radius:4px;"><i class="fa-solid fa-triangle-exclamation"></i> <strong>Ghi chú:</strong> ${it.text}</div>`;
                        } else if (it.type === 'image') {
                            div.innerHTML += `<div><img src="${it.text}" alt="Hình minh họa" onerror="this.style.display='none'"></div>`;
                        } else {
                            div.innerHTML += `<div style="margin:4px 0;">${it.label ? `<strong style="color:#2ecc71;">${it.label}:</strong> ` : ''}${it.text || ''}</div>`;
                        }
                    });
                    body.appendChild(div);
                });
            } else {
                body.innerHTML = `<div class="empty-msg">Không có dữ liệu chi tiết để hiển thị.</div>`;
            }

            document.getElementById('content-preview-modal').style.display = 'flex';
            renderMath(body);
        }

