        function downloadJsonFile(objectData, fileName) {
            try {
                const jsonStr = JSON.stringify(objectData, null, 2);
                const blob = new Blob([jsonStr], { type: "application/json;charset=utf-8;" });
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                link.setAttribute("href", url);
                link.setAttribute("download", fileName);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
                showToast(`Đã tải xuống file "${fileName}"!`, "success");
            } catch (err) {
                console.error("[downloadJsonFile] Error:", err);
                showToast("Lỗi khi tải file: " + err.message, "error");
            }
        }

        function xuatToanBoDuLieuJson() {
            const timeStamp = new Date().toISOString().replace(/[:.]/g, '-');
            const fileName = `hero_math_full_backup_${timeStamp}.json`;

            const studentProfiles = {};
            for (let i = 0; i < localStorage.length; i++) {
                const k = localStorage.key(i);
                if (!k) continue;
                if (k.startsWith('exp_') || k.startsWith('coin_') || k.startsWith('da_quay_') ||
                    k.startsWith('luot_lam_bai_') || k.startsWith('luot_boss_') ||
                    k.startsWith('luot_vong_quay_') || k.startsWith('luot_thach_dau_') ||
                    k.startsWith('luot_vuot_ai_') || k.startsWith('ruong_do_')) {
                    studentProfiles[k] = localStorage.getItem(k);
                }
            }

            const backupObj = {
                appName: "HERO_MATH",
                version: "2.5",
                exportTime: new Date().toISOString(),
                globals: {
                    ngan_hang_de_trac_nghiem: safeJsonParse('ngan_hang_de_trac_nghiem', []),
                    ngan_hang_de_boss: safeJsonParse('ngan_hang_de_boss', []),
                    ngan_hang_de_vuot_ai: safeJsonParse('ngan_hang_de_vuot_ai', []),
                    danh_sach_bai_hoc_ly_thuyet: safeJsonParse('danh_sach_bai_hoc_ly_thuyet', []),
                    math_hero_users_v2: safeJsonParse('math_hero_users_v2', {}),
                    nhat_ky_dang_nhap: safeJsonParse('nhat_ky_dang_nhap', []),
                    so_luot_lam_bai_toi_da: localStorage.getItem('so_luot_lam_bai_toi_da') || 3,
                    so_luot_boss_toi_da: localStorage.getItem('so_luot_boss_toi_da') || 3,
                    so_luot_vong_quay_toi_da: localStorage.getItem('so_luot_vong_quay_toi_da') || 1,
                    so_luot_vuot_ai_toi_da: localStorage.getItem('so_luot_vuot_ai_toi_da') || 3
