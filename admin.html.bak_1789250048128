    <!-- Nạp ES Modules nâng cao nếu hỗ trợ (Live Server / Hosting) -->
    <script type="module">
        try {
            const FirebaseSync = await import('./firebase-sync.js');
            const { kiemTraMatKhauGiaoVien, hashMatKhau } = await import('./hero-auth.js');
            const { luuDuLieu, docDuLieu, xoaDuLieu } = await import('./hero-storage.js');
            
            if (FirebaseSync) window.FirebaseSync = FirebaseSync;
            window.__authKiemTraMatKhauGV = kiemTraMatKhauGiaoVien;
            window.__authHashMatKhau = hashMatKhau;
            window.__heroStorage = { luuDuLieu, docDuLieu, xoaDuLieu };
            console.log("[Admin] Đã nạp thành công firebase-sync.js + hero-auth.js");
        } catch(e) {
            console.log("[Admin] Đang chạy chế độ tương thích trực tiếp (hero-firebase-compat.js):", e.message);
        }
        window.firebaseSyncSan = true;
    </script>

    <script>
        // Kiểm tra quyền truy cập Admin (Chạy độc lập trên mọi giao thức bao gồm file:///)
        window.kiemTraQuyenTruyCapAdmin = function() {
            const adminMode = sessionStorage.getItem('hero_admin_mode') || localStorage.getItem('hero_admin_mode');
            const gvAuth = sessionStorage.getItem('teacher_authenticated') || localStorage.getItem('teacher_authenticated');
            
            if (adminMode === 'admin' || adminMode === 'edit' || gvAuth === 'true') {
                sessionStorage.setItem('hero_admin_mode', 'admin');
                localStorage.setItem('hero_admin_mode', 'admin');
                sessionStorage.setItem('teacher_authenticated', 'true');
                localStorage.setItem('teacher_authenticated', 'true');
                const modal = document.getElementById('admin-auth-modal');
                if (modal) modal.style.display = 'none';
                return true;
            }

            // Nếu chưa xác thực, hiện modal đăng nhập admin
            const modal = document.getElementById('admin-auth-modal');
            if (modal) {
                modal.style.display = 'flex';
                const input = document.getElementById('admin-page-pwd-input');
                if (input) {
                    input.value = '';
                    input.focus();
                }
                const err = document.getElementById('admin-page-pwd-error');
                if (err) err.style.display = 'none';
            }
            return false;
        };

        window.kiemTraQuyenTruyCapAdmin();
    </script>

