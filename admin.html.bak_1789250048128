                        html += `<div style="font-size:0.9rem; color:#cbd5e1; margin:6px 0;">`;
                        q.answers.forEach((opt, i) => {
                            html += `<div>${String.fromCharCode(65 + i)}. ${opt}</div>`;
                        });
                        html += `</div>`;
                    }
                    html += `<div style="color:#2ecc71; font-size:0.85rem;"><strong>Đáp án đúng:</strong> ${String.fromCharCode(65 + (q.correct || 0))}</div>`;
                    if (q.explanation) {
                        html += `<div style="color:#f39c12; font-size:0.85rem; margin-top:4px;"><strong>Giải thích:</strong> ${q.explanation}</div>`;
                    }
                    html += `</div>`;
                });
                return html;
            }

            // 2. Trắc nghiệm
            const pTn = document.getElementById('ai-res-panel-trac_nghiem');
            if (pTn) pTn.innerHTML = renderCauHoiList(ketQuaAiTatCa.trac_nghiem, '#2ecc71', 'trac_nghiem');

            // 3. Boss
            const pBoss = document.getElementById('ai-res-panel-boss');
            if (pBoss) pBoss.innerHTML = renderCauHoiList(ketQuaAiTatCa.boss, '#e74c3c', 'boss');

            // 4. Vượt ải
            const pVa = document.getElementById('ai-res-panel-vuot_ai');
            if (pVa) pVa.innerHTML = renderCauHoiList(ketQuaAiTatCa.vuot_ai, '#9b59b6', 'vuot_ai');

            // Kích hoạt MathJax hiển thị công thức đẹp
            if (window.MathJax && window.MathJax.typesetPromise) {
                window.MathJax.typesetPromise();
            }
        }

        // LƯU TẤT CẢ VÀO HỆ THỐNG & ĐỒNG BỘ CLOUD
        window.dayTatCa4MucVaoAdmin = async function() {
            if (!ketQuaAiTatCa) return;

            const khoi = document.getElementById('ai-studio-khoi').value;
            const tenChuDe = document.getElementById('ai-studio-ten-chude').value.trim() || 'Bài học toán mới';
