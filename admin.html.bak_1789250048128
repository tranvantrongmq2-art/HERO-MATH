        function dinhDangJsonEditor() {
            try {
                const raw = document.getElementById('edit-json').value;
                const obj = JSON.parse(raw);
                document.getElementById('edit-json').value = JSON.stringify(obj, null, 2);
                showToast("Đã định dạng JSON chuẩn!", "success");
            } catch (e) {
                showToast("JSON không hợp lệ, không thể làm đẹp: " + e.message, "error");
            }
        }

        function luuSuaNoiDung() {
            try {
                const raw = document.getElementById('edit-json').value;
                const newData = JSON.parse(raw);
                const key = KHO_KEY_MAP[editItemLoai];

                if (!key) {
                    showToast("Lỗi: Không xác định được loại dữ liệu cần cập nhật!", "error");
                    return;
                }

                let list = safeJsonParse(key, []);
                const index = list.findIndex(x => x.id === editItemId);

                if (index === -1) {
                    showToast("Không tìm thấy mục cần cập nhật!", "error");
                    return;
                }

                list[index] = { ...list[index], ...newData, id: editItemId, capNhatLuc: Date.now() };
                safeJsonSet(key, list);
                dongBoToanCuc(key);

                // Đảm bảo ID không bị tombstone chặn
                const tombKey = (key === 'danh_sach_bai_hoc_ly_thuyet') ? 'danh_sach_bai_hoc_ly_thuyet_da_xoa' : (key + '_da_xoa');
                let dsDaXoa = safeJsonParse(tombKey, []);
                if (Array.isArray(dsDaXoa) && dsDaXoa.includes(editItemId)) {
                    dsDaXoa = dsDaXoa.filter(x => x !== editItemId);
                    safeJsonSet(tombKey, dsDaXoa);
                    dongBoToanCuc(tombKey);
                }

                showToast("Đã cập nhật nội dung thành công!", "success");
                dongEditModal();

                switch (editItemLoai) {
                    case 'trac_nghiem': hienThiDanhSachThuMucDe(); break;
                    case 'boss': hienThiDanhSachThuMucDeBoss(); break;
                    case 'vuot_ai': hienThiDanhSachThuMucDeVuotAi(); break;
                    case 'ly_thuyet': hienThiDanhSachLyThuyet(); break;
                }
            } catch (e) {
                showToast("Lỗi cú pháp JSON: " + e.message, "error");
            }
        }

