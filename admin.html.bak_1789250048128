        function moModalSuaHocSinh(tenHs) {
            const users = safeJsonParse('math_hero_users_v2', {});
            const userData = users[tenHs];
            if (!userData) {
                showToast("Không tìm thấy thông tin chiến binh!", "error");
                return;
            }

            document.getElementById('student-modal-title').innerHTML = `<i class="fa-solid fa-user-pen"></i> Sửa Thông Tin Chiến Binh: ${tenHs}`;
            document.getElementById('student-edit-mode').value = 'edit';
            document.getElementById('student-old-name').value = tenHs;
            
            document.getElementById('inp-hs-name').value = tenHs;
            document.getElementById('inp-hs-name').disabled = true;

            if (typeof userData === 'string') {
                document.getElementById('inp-hs-pass').value = userData;
                document.getElementById('inp-hs-class').value = 'Khối 7';
                document.getElementById('inp-hs-classroom').value = '';
            } else {
                document.getElementById('inp-hs-pass').value = userData.pass || '';
                document.getElementById('inp-hs-class').value = userData.class || 'Khối 7';
                document.getElementById('inp-hs-classroom').value = userData.classroom || '';
            }

            document.getElementById('inp-hs-exp').value = localStorage.getItem('exp_' + tenHs) || 0;
            document.getElementById('inp-hs-coin').value = localStorage.getItem('coin_' + tenHs) || 50;

            document.getElementById('student-modal').style.display = 'flex';
        }

        function dongStudentModal() {
            document.getElementById('student-modal').style.display = 'none';
        }

        function luuThongTinHocSinh() {
            const mode = document.getElementById('student-edit-mode').value;
            const ten = document.getElementById('inp-hs-name').value.trim();
            const lop = document.getElementById('inp-hs-class').value;
            const lopCuThe = document.getElementById('inp-hs-classroom').value.trim();
            const pass = document.getElementById('inp-hs-pass').value.trim();
            const exp = parseInt(document.getElementById('inp-hs-exp').value) || 0;
            const coin = parseInt(document.getElementById('inp-hs-coin').value) || 0;

            if (!ten || !pass) {
                showToast("Vui lòng điền đầy đủ Họ Tên và Mật Mã!", "warning");
                return;
            }

            let users = safeJsonParse('math_hero_users_v2', {});

            if (mode === 'add') {
                if (users[ten]) {
                    showToast(`Chiến binh "${ten}" đã tồn tại trên hệ thống!`, "error");
                    return;
                }
            }

            users[ten] = {
                class: lop,
                classroom: lopCuThe,
                pass: pass
            };
            safeJsonSet('math_hero_users_v2', users);
            dongBoToanCuc('math_hero_users_v2');

            localStorage.setItem('exp_' + ten, exp);
            localStorage.setItem('coin_' + ten, coin);
            dongBoHocSinh(ten);

            showToast(mode === 'add' ? `Đã thêm thành công chiến binh ${ten}!` : `Đã cập nhật thông tin chiến binh ${ten}!`, "success");
            dongStudentModal();
            taiLogHocSinh();
        }

        function xoaChiTietWarriors(tenHs) {
            customConfirm(`Thầy có chắc chắn muốn xóa TOÀN BỘ dữ liệu của tài khoản "${tenHs}" không?`, () => {
                let users = safeJsonParse('math_hero_users_v2', {});
                delete users[tenHs];
                safeJsonSet('math_hero_users_v2', users);
                dongBoToanCuc('math_hero_users_v2');

                localStorage.removeItem('exp_' + tenHs);
                localStorage.removeItem('coin_' + tenHs);
                localStorage.removeItem('da_quay_' + tenHs);
                localStorage.removeItem('luot_lam_bai_' + tenHs);
                localStorage.removeItem('luot_boss_' + tenHs);
                localStorage.removeItem('luot_vong_quay_' + tenHs);
                localStorage.removeItem('luot_thach_dau_' + tenHs);
                localStorage.removeItem('luot_vuot_ai_' + tenHs);
                localStorage.removeItem('ruong_do_' + tenHs);

                xoaHocSinhFirebase(tenHs);
                showToast(`Đã xóa sạch tài khoản "${tenHs}"!`, "success");
                taiLogHocSinh();
            });
        }

        function clearToanBoHocSinh() {
            customConfirm("CẢNH BÁO NGUY HIỂM: Thầy muốn xóa SẠCH toàn bộ học sinh và điểm số trong hệ thống?", () => {
                let users = safeJsonParse('math_hero_users_v2', {});
                Object.keys(users).forEach(ten => xoaHocSinhFirebase(ten));
                localStorage.removeItem('math_hero_users_v2');
                dongBoToanCuc('math_hero_users_v2');

                let keysReset = [];
                for (let i = 0; i < localStorage.length; i++) {
                    let k = localStorage.key(i);
                    if (k && (k.startsWith('exp_') || k.startsWith('coin_') || k.startsWith('da_quay_') ||
                             k.startsWith('luot_lam_bai_') || k.startsWith('luot_boss_') ||
                             k.startsWith('luot_vong_quay_') || k.startsWith('luot_thach_dau_') ||
                             k.startsWith('luot_vuot_ai_') || k.startsWith('ruong_do_'))) {
                        keysReset.push(k);
                    }
                }
                keysReset.forEach(k => localStorage.removeItem(k));
                showToast("Đã dọn sạch cơ sở dữ liệu học sinh!", "success");
                taiLogHocSinh();
            });
        }

