        function taiLogHocSinh() {
            const tbody = document.getElementById('tbl-admin-hs');
            if (!tbody) return;
            tbody.innerHTML = "";

            const users = safeJsonParse('math_hero_users_v2', {});
            let userNames = Object.keys(users);

            if (userNames.length === 0) {
                tbody.innerHTML = `<tr><td colspan="12" class="empty-msg">Chưa có dữ liệu học sinh đăng ký trong hệ thống.</td></tr>`;
                return;
            }

            const searchKw = (document.getElementById('search-student')?.value || '').trim().toLowerCase();
            const filterGrade = document.getElementById('filter-student-grade')?.value || 'all';
            const sortMode = document.getElementById('sort-student')?.value || 'name_asc';

            // Lấy thời gian truy cập gần nhất của từng học sinh từ nhật ký đăng nhập
            const nhatKyDangNhap = safeJsonParse('nhat_ky_dang_nhap', []);
            const lastLoginMap = {};
            nhatKyDangNhap.forEach(item => {
                if (item && item.name) lastLoginMap[item.name] = item.time || '—';
            });

            const homNay = new Date().toLocaleDateString('vi-VN');
            const soLuotLamBaiMax = parseInt(localStorage.getItem('so_luot_lam_bai_toi_da')) || 3;
            const soLuotBossMax = parseInt(localStorage.getItem('so_luot_boss_toi_da')) || 3;
            const soLuotVongQuayMax = parseInt(localStorage.getItem('so_luot_vong_quay_toi_da')) || 1;
            const soLuotVuotAiMax = parseInt(localStorage.getItem('so_luot_vuot_ai_toi_da')) || 3;

            let listStudents = userNames.map(ten => {
                const userData = users[ten];
                let matKhau = "Không rõ";
                let lop = "Khối 7";
                let lopCuThe = "—";

                if (typeof userData === 'string') {
                    matKhau = userData;
                } else if (typeof userData === 'object' && userData !== null) {
                    matKhau = userData.pass || "Không rõ";
                    lop = userData.class || "Khối 7";
                    lopCuThe = userData.classroom || "—";
                }

                const diem = parseInt(localStorage.getItem('exp_' + ten)) || 0;
                const xu = parseInt(localStorage.getItem('coin_' + ten)) || 50;

                const rawLB = safeJsonParse('luot_lam_bai_' + ten, null);
                const luotLamBai = (rawLB && rawLB.date === homNay) ? rawLB.soLuotConLai : soLuotLamBaiMax;

                const rawBoss = safeJsonParse('luot_boss_' + ten, null);
                const luotBoss = rawBoss ? rawBoss.soLuotConLai : soLuotBossMax;

                const rawVQ = safeJsonParse('luot_vong_quay_' + ten, null);
                const luotVQ = (rawVQ && rawVQ.date === homNay) ? rawVQ.soLuotConLai : soLuotVongQuayMax;

                const rawVA = safeJsonParse('luot_vuot_ai_' + ten, null);
                const luotVA = (rawVA && rawVA.date === homNay) ? rawVA.soLuotConLai : soLuotVuotAiMax;

                return {
                    name: ten,
                    pass: matKhau,
                    class: lop,
                    classroom: lopCuThe,
                    exp: diem,
                    coin: xu,
                    luotLB: luotLamBai,
                    luotBoss: luotBoss,
                    luotVQ: luotVQ,
                    luotVA: luotVA,
                    lastLogin: lastLoginMap[ten] || '—'
                };
            });

            if (searchKw) {
                listStudents = listStudents.filter(hs => 
                    hs.name.toLowerCase().includes(searchKw) || 
                    hs.classroom.toLowerCase().includes(searchKw) ||
                    hs.class.toLowerCase().includes(searchKw)
                );
            }

            if (filterGrade !== 'all') {
                listStudents = listStudents.filter(hs => hs.class === filterGrade);
            }

            if (sortMode === 'name_asc') {
                listStudents.sort((a, b) => a.name.localeCompare(b.name, 'vi'));
            } else if (sortMode === 'exp_desc') {
                listStudents.sort((a, b) => b.exp - a.exp);
            } else if (sortMode === 'coin_desc') {
                listStudents.sort((a, b) => b.coin - a.coin);
            } else if (sortMode === 'login_desc') {
                listStudents.sort((a, b) => (b.lastLogin === '—' ? '' : b.lastLogin).localeCompare(a.lastLogin === '—' ? '' : a.lastLogin));
            }

            if (listStudents.length === 0) {
                tbody.innerHTML = `<tr><td colspan="12" class="empty-msg">Không tìm thấy học sinh nào phù hợp với bộ lọc hiện tại.</td></tr>`;
                return;
            }

            listStudents.forEach(hs => {
                const mauLB = hs.luotLB > 0 ? '#2ecc71' : '#e74c3c';
                const mauBoss = hs.luotBoss > 0 ? '#e74c3c' : '#7f8c8d';
                const mauVQ = hs.luotVQ > 0 ? '#f39c12' : '#7f8c8d';
                const mauVA = hs.luotVA > 0 ? '#9b59b6' : '#7f8c8d';

                tbody.innerHTML += `
                    <tr>
                        <td style="font-weight:bold; color:#fff;">${hs.name}</td>
                        <td><span style="color:#3498db; font-weight:bold;">${hs.class}</span></td>
                        <td><span style="color:#2ecc71; font-weight:bold;">${hs.classroom}</span></td>
                        <td style="color:#e74c3c; font-family: monospace; letter-spacing: 1px;">${hs.pass}</td>
                        <td style="text-align: right; color:#f1c40f; font-weight: bold;"><i class="fa-solid fa-star"></i> ${hs.exp}</td>
                        <td style="text-align: right; color:#ffeb3b; font-weight: bold;"><i class="fa-solid fa-coins"></i> ${hs.coin}</td>
                        <td style="text-align: center;">
                            <span style="color:${mauLB}; font-weight:bold;">${hs.luotLB}</span> 
                            <button onclick="resetLuotLamBaiChoHocSinh('${hs.name}')" title="Reset lượt làm bài" style="background:transparent;border:none;cursor:pointer;color:#1abc9c;margin-left:4px;"><i class="fa-solid fa-rotate-left"></i></button>
                        </td>
                        <td style="text-align: center;">
                            <span style="color:${mauBoss}; font-weight:bold;">${hs.luotBoss}</span> 
                            <button onclick="resetLuotBossChoHocSinh('${hs.name}')" title="Reset lượt Thử Thách Tối Thượng" style="background:transparent;border:none;cursor:pointer;color:#e74c3c;margin-left:4px;"><i class="fa-solid fa-rotate-left"></i></button>
                        </td>
                        <td style="text-align: center;">
                            <span style="color:${mauVQ}; font-weight:bold;">${hs.luotVQ}</span> 
                            <button onclick="resetLuotVongQuayChoHocSinh('${hs.name}')" title="Reset lượt Vòng Quay" style="background:transparent;border:none;cursor:pointer;color:#f39c12;margin-left:4px;"><i class="fa-solid fa-rotate-left"></i></button>
                        </td>
                        <td style="text-align: center;">
                            <span style="color:${mauVA}; font-weight:bold;">${hs.luotVA}</span> 
                            <button onclick="resetLuotVuotAiChoHocSinh('${hs.name}')" title="Reset lượt Nâng Cấp Tư Duy" style="background:transparent;border:none;cursor:pointer;color:#9b59b6;margin-left:4px;"><i class="fa-solid fa-rotate-left"></i></button>
                        </td>
                        <td style="color:#bdc3c7; font-size:0.85rem; white-space: nowrap;">${hs.lastLogin}</td>
                        <td style="text-align: center;">
                            <button onclick="moModalSuaHocSinh('${hs.name}')" class="btn-edit" title="Sửa thông tin học sinh"><i class="fa-solid fa-pen"></i></button>
                            <button onclick="xoaChiTietWarriors('${hs.name}')" class="btn-trash-warrior" title="Xóa tài khoản này"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

