        async function thucHienImportJson() {
            const rawJson = document.getElementById('txt-import-json').value.trim();
            if (!rawJson) {
                showToast("Vui lòng chọn file hoặc dán nội dung JSON cần nạp!", "warning");
                return;
            }

            let parsed = null;
            try {
                parsed = JSON.parse(rawJson);
            } catch (err) {
                showToast("Lỗi: Dữ liệu JSON không hợp lệ! " + err.message, "error");
                return;
            }

            const radios = document.getElementsByName('import-mode');
            let importMode = 'merge';
            for (const r of radios) { if (r.checked) importMode = r.value; }

            const xacNhanText = importMode === 'overwrite' ? 
                "CẢNH BÁO: Chế độ 'Ghi đè' sẽ thay thế các mục trùng lặp trong hệ thống bằng dữ liệu file nạp. Tiếp tục?" : 
                "Hệ thống sẽ gộp dữ liệu từ file vào cơ sở dữ liệu hiện có. Tiếp tục?";

            customConfirm(xacNhanText, async () => {
                try {
                    let totalImports = 0;

                    // TRƯỜNG HỢP 1: FULL BACKUP
                    if (parsed.globals) {
                        const g = parsed.globals;

                        if (Array.isArray(g.ngan_hang_de_trac_nghiem)) {
                            if (importMode === 'overwrite') {
                                safeJsonSet('ngan_hang_de_trac_nghiem', g.ngan_hang_de_trac_nghiem);
                            } else {
                                let cur = safeJsonParse('ngan_hang_de_trac_nghiem', []);
                                const existingIds = new Set(cur.map(x => x.id));
                                g.ngan_hang_de_trac_nghiem.forEach(item => {
                                    if (!existingIds.has(item.id)) cur.push(item);
                                });
                                safeJsonSet('ngan_hang_de_trac_nghiem', cur);
                            }
                            await dongBoToanCuc('ngan_hang_de_trac_nghiem');
                            totalImports += g.ngan_hang_de_trac_nghiem.length;
                        }

                        if (Array.isArray(g.ngan_hang_de_boss)) {
                            if (importMode === 'overwrite') {
                                safeJsonSet('ngan_hang_de_boss', g.ngan_hang_de_boss);
                            } else {
                                let cur = safeJsonParse('ngan_hang_de_boss', []);
                                const existingIds = new Set(cur.map(x => x.id));
                                g.ngan_hang_de_boss.forEach(item => {
                                    if (!existingIds.has(item.id)) cur.push(item);
                                });
                                safeJsonSet('ngan_hang_de_boss', cur);
                            }
                            await dongBoToanCuc('ngan_hang_de_boss');
                            totalImports += g.ngan_hang_de_boss.length;
                        }

                        if (Array.isArray(g.ngan_hang_de_vuot_ai)) {
                            if (importMode === 'overwrite') {
                                safeJsonSet('ngan_hang_de_vuot_ai', g.ngan_hang_de_vuot_ai);
                            } else {
                                let cur = safeJsonParse('ngan_hang_de_vuot_ai', []);
                                const existingIds = new Set(cur.map(x => x.id));
                                g.ngan_hang_de_vuot_ai.forEach(item => {
                                    if (!existingIds.has(item.id)) cur.push(item);
                                });
                                safeJsonSet('ngan_hang_de_vuot_ai', cur);
                            }
                            await dongBoToanCuc('ngan_hang_de_vuot_ai');
                            totalImports += g.ngan_hang_de_vuot_ai.length;
                        }

                        if (Array.isArray(g.danh_sach_bai_hoc_ly_thuyet)) {
                            if (importMode === 'overwrite') {
                                safeJsonSet('danh_sach_bai_hoc_ly_thuyet', g.danh_sach_bai_hoc_ly_thuyet);
                            } else {
                                let cur = safeJsonParse('danh_sach_bai_hoc_ly_thuyet', []);
                                const existingIds = new Set(cur.map(x => x.id));
                                g.danh_sach_bai_hoc_ly_thuyet.forEach(item => {
                                    if (!existingIds.has(item.id)) cur.push(item);
                                });
                                safeJsonSet('danh_sach_bai_hoc_ly_thuyet', cur);
                            }
                            await dongBoToanCuc('danh_sach_bai_hoc_ly_thuyet');
                            totalImports += g.danh_sach_bai_hoc_ly_thuyet.length;
                        }

                        if (g.math_hero_users_v2 && typeof g.math_hero_users_v2 === 'object') {
                            let curUsers = importMode === 'overwrite' ? {} : safeJsonParse('math_hero_users_v2', {});
                            Object.keys(g.math_hero_users_v2).forEach(u => {
                                curUsers[u] = g.math_hero_users_v2[u];
                            });
                            safeJsonSet('math_hero_users_v2', curUsers);
                            await dongBoToanCuc('math_hero_users_v2');
                        }

                        ['so_luot_lam_bai_toi_da', 'so_luot_boss_toi_da', 'so_luot_vong_quay_toi_da', 'so_luot_vuot_ai_toi_da'].forEach(async k => {
                            if (g[k] !== undefined) {
                                localStorage.setItem(k, g[k]);
                                await dongBoToanCuc(k);
                            }
                        });

                        if (parsed.studentProfiles && typeof parsed.studentProfiles === 'object') {
                            Object.keys(parsed.studentProfiles).forEach(k => {
                                localStorage.setItem(k, parsed.studentProfiles[k]);
                            });
                        }
                    } 
                    else if (parsed.key && Array.isArray(parsed.items)) {
                        const targetKey = parsed.key;
                        if (importMode === 'overwrite') {
                            safeJsonSet(targetKey, parsed.items);
                        } else {
                            let cur = safeJsonParse(targetKey, []);
                            const existingIds = new Set(cur.map(x => x.id));
                            parsed.items.forEach(item => {
                                if (!existingIds.has(item.id)) cur.push(item);
                            });
                            safeJsonSet(targetKey, cur);
                        }
                        await dongBoToanCuc(targetKey);
                        totalImports += parsed.items.length;
                    }
                    else if (parsed.category === 'hoc_sinh' && parsed.users) {
                        let curUsers = importMode === 'overwrite' ? {} : safeJsonParse('math_hero_users_v2', {});
                        Object.keys(parsed.users).forEach(u => {
                            curUsers[u] = parsed.users[u];
                        });
                        safeJsonSet('math_hero_users_v2', curUsers);
                        await dongBoToanCuc('math_hero_users_v2');

                        if (parsed.profiles) {
                            Object.keys(parsed.profiles).forEach(k => {
                                localStorage.setItem(k, parsed.profiles[k]);
                            });
                        }
                        totalImports += Object.keys(parsed.users).length;
                    } 
                    else {
                        showToast("Cấu trúc file JSON chưa phù hợp với định dạng sao lưu của HERO MATH!", "error");
                        return;
                    }

                    showToast(`Phục hồi dữ liệu thành công (${totalImports} mục)!`, "success");
                    dongBackupModal();
                    taiDuLieuHeThongAdmin();
                } catch (err) {
                    console.error("[thucHienImportJson] Error:", err);
                    showToast("Lỗi khi phục hồi dữ liệu: " + err.message, "error");
                }
            });
        }

