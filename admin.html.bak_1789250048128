                try {
                    // 1. Xóa local + cập nhật tombstone cho tất cả bài hiện có
                    let dsBaiHoc = safeJsonParse('danh_sach_bai_hoc_ly_thuyet', []);
                    let dsDaXoa = safeJsonParse('danh_sach_bai_hoc_ly_thuyet_da_xoa', []);
                    if (!Array.isArray(dsDaXoa)) dsDaXoa = [];
                    dsBaiHoc.forEach(b => { if (b && b.id && !dsDaXoa.includes(b.id)) dsDaXoa.push(b.id); });

                    safeJsonSet('danh_sach_bai_hoc_ly_thuyet', []);
                    safeJsonSet('danh_sach_bai_hoc_ly_thuyet_da_xoa', dsDaXoa);
                    localStorage.removeItem('hero_da_xoa_ly_thuyet');

                    // 2. Ghi đè thẳng Firebase bằng [] — BYPASS merge logic hoàn toàn
                    let ghiThanhCong = false;

                    // Ưu tiên HeroFirebaseCompat.forceGhiDeFirebase (chạy được trên file:///)
                    if (window.HeroFirebaseCompat && typeof window.HeroFirebaseCompat.forceGhiDeFirebase === 'function') {
                        await window.HeroFirebaseCompat.forceGhiDeFirebase('mathhero_global', 'danh_sach_bai_hoc_ly_thuyet', {
                            value: JSON.stringify([]),
                            _capNhatLanCuoi: new Date().toISOString()
                        });
                        await window.HeroFirebaseCompat.forceGhiDeFirebase('mathhero_global', 'danh_sach_bai_hoc_ly_thuyet_da_xoa', {
                            value: JSON.stringify(dsDaXoa),
                            _capNhatLanCuoi: new Date().toISOString()
                        });
                        ghiThanhCong = true;
                    }
                    // Fallback: dùng dayCauHinhToanCuc thông thường (ghi localStorage hiện tại lên Firebase)
                    else if (window.HeroFirebaseCompat && typeof window.HeroFirebaseCompat.dayCauHinhToanCuc === 'function') {
                        await window.HeroFirebaseCompat.dayCauHinhToanCuc('danh_sach_bai_hoc_ly_thuyet');
                        await window.HeroFirebaseCompat.dayCauHinhToanCuc('danh_sach_bai_hoc_ly_thuyet_da_xoa');
                        ghiThanhCong = true;
                    }
                    // Fallback cuối: dongBoToanCuc thông thường
                    else {
                        await dongBoToanCuc('danh_sach_bai_hoc_ly_thuyet');
                        await dongBoToanCuc('danh_sach_bai_hoc_ly_thuyet_da_xoa');
                        ghiThanhCong = true;
                    }

                    // 3. Bắn sự kiện để ly-thuyet.html cập nhật ngay
                    try {
                        window.dispatchEvent(new StorageEvent('storage', {
                            key: 'danh_sach_bai_hoc_ly_thuyet',
                            newValue: JSON.stringify([])
                        }));
                    } catch(e) {}

                    if (ghiThanhCong) {
                        showToast('✅ Đã xóa trắng Firebase thành công! Dữ liệu lý thuyết cũ sẽ không còn sync lại.', 'success');
                    } else {
                        showToast('⚠️ Đã xóa local nhưng không kết nối được Firebase. Hãy thử lại khi có mạng.', 'warning');
                    }
                    hienThiDanhSachLyThuyet();
                } catch (err) {
                    console.error('[xoaTrangFirebaseLyThuyet] Lỗi:', err);
                    showToast('Lỗi khi xóa Firebase: ' + err.message, 'error');
                }
            });
        }

