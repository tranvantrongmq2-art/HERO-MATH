        // ============================================================
        //  3. BỘ BIÊN DỊCH CÂU HỎI VĂN BẢN (ROBUST PARSER ENGINE)
        // ============================================================
        function bienDichVanBanThanhCauHoi(noiDungRaw) {
            if (!noiDungRaw || typeof noiDungRaw !== 'string') return [];
            
            let vanBan = noiDungRaw
                .replace(/<br\s*\/?>/gi, '\n')
                .replace(/\r\n/g, '\n')
                .replace(/\r/g, '\n')
                .replace(/\*\*(.*?)\*\*/g, '$1')
                .replace(/__(.*?)__/g, '$1');

            const rawLines = vanBan.split('\n').map(l => l.trim()).filter(l => l.length > 0);
            const blocks = [];
            let currentBlock = [];

            // Regex linh hoạt nhận diện đầu câu hỏi
            const isQuestionStart = (line) => {
                return /^(?:câu|âu|bài|bai|câu hỏi)?\s*\d+\s*[:.\-–]\s*/i.test(line);
            };

            rawLines.forEach(line => {
                if (isQuestionStart(line)) {
                    if (currentBlock.length > 0) blocks.push(currentBlock);
                    currentBlock = [line];
                } else {
                    if (currentBlock.length === 0) {
                        currentBlock = [line];
                    } else {
                        currentBlock.push(line);
                    }
                }
            });
            if (currentBlock.length > 0) blocks.push(currentBlock);

            const danhSachCauHoi = [];

            blocks.forEach(lines => {
                let deBai = "";
                let opA = "", opB = "", opC = "", opD = "";
                let dapAnIndex = 0;
                let hinhAnh = "";
                let giaiThich = "";
                
                // Trạng thái bóc tách: 0 = Đang đọc đề bài, 1 = Đang đọc đáp án, 2 = Đang đọc lời giải
                let currentSection = 0; 

                lines.forEach((rawLine, idx) => {
                    let line = rawLine;

                    // Nếu là dòng mở đầu câu hỏi, loại bỏ tiền tố đánh số câu
                    if (idx === 0) {
                        line = line.replace(/^(?:câu|âu|bài|bai|câu hỏi)?\s*\d+\s*[:.\-–]\s*/i, '').trim();
                    }
                    if (line.length === 0) return;

                    const upperLine = line.toUpperCase();

                    // 1. Kiểm tra hình ảnh minh họa
                    const isImageLabel = /^(?:link\s*ảnh|link\s*anh|hình\s*ảnh|hinh\s*anh|ảnh|anh)\s*[:.\-–]\s*(.*)/i.exec(line);
                    if (isImageLabel) {
                        hinhAnh = isImageLabel[1].trim();
                        return;
                    }
                    if (/^https?:\/\/\S+\.(?:png|jpe?g|gif|webp|svg)/i.test(line)) {
                        hinhAnh = line.trim();
                        return;
                    }

                    // 2. Kiểm tra các phương án A, B, C, D
                    const optMatch = line.match(/^[-*•\s]*\$?([A-D])\$?\s*[\.\):\-–]\s*(.*)/i) ||
                                     line.match(/^[-*•\s]*\(([A-D])\)\s*(.*)/i) ||
                                     line.match(/^[-*•\s]*\[([A-D])\]\s*(.*)/i);
                    if (optMatch) {
                        currentSection = 1;
                        const optChar = optMatch[1].toUpperCase();
                        const optContent = optMatch[2].trim();
                        if (optChar === 'A') opA = optContent;
                        else if (optChar === 'B') opB = optContent;
                        else if (optChar === 'C') opC = optContent;
                        else if (optChar === 'D') opD = optContent;
                        return;
                    }

                    // 3. Kiểm tra dòng Đáp án đúng
                    if (upperLine.startsWith("ĐÁP ÁN:") || upperLine.startsWith("DAP AN:") ||
                        upperLine.startsWith("KEY:") || upperLine.startsWith("ĐÁP ÁN ĐÚNG:") || upperLine.startsWith("CHỌN:")) {
                        const colonIdx = line.indexOf(":");
                        const ansPart = colonIdx !== -1 ? line.substring(colonIdx + 1).trim() : line;
                        const letterMatch = ansPart.match(/[A-D]/i);
                        const letter = letterMatch ? letterMatch[0].toUpperCase() : 'A';
                        if (letter === 'A') dapAnIndex = 0;
                        else if (letter === 'B') dapAnIndex = 1;
                        else if (letter === 'C') dapAnIndex = 2;
                        else if (letter === 'D') dapAnIndex = 3;
                        return;
                    }

                    // 4. Kiểm tra dòng Bắt đầu giải thích
                    if (upperLine.startsWith("GIẢI THÍCH:") || upperLine.startsWith("GIAI THICH:") ||
                        upperLine.startsWith("LỜI GIẢI:") || upperLine.startsWith("HƯỚNG DẪN:")) {
                        currentSection = 2;
                        const colonIdx = line.indexOf(":");
                        giaiThich = colonIdx !== -1 ? line.substring(colonIdx + 1).trim() : "";
                        return;
                    }

                    // 5. Nội dung bổ sung đa dòng (đề bài hoặc lời giải)
                    if (currentSection === 2) {
                        // Tiếp tục nối vào phần Giải thích (không để rò rỉ vào đề bài)
                        if (giaiThich) giaiThich += "<br>" + line;
                        else giaiThich = line;
                    } else if (currentSection === 0) {
                        // Đang đọc phần đề bài
                        if (deBai) deBai += "<br>" + line;
                        else deBai = line;
                    }
                });

                if (deBai && (opA || opB)) {
                    danhSachCauHoi.push({
                        question: deBai,
                        answers: [opA, opB, opC, opD],
                        correct: dapAnIndex,
                        image: hinhAnh,
                        explanation: giaiThich
                    });
                }
            });

            return danhSachCauHoi;
        }

        // ============================================================
        //  4. BỘ BIÊN DỊCH BÀI HỌC LÝ THUYẾT (THEORY PARSER)
        // ============================================================
        function parseLyThuyet(noiDung) {
            if (!noiDung || typeof noiDung !== 'string') return [];
            const lines = noiDung.split('\n');
            const children = [];
            let currentChild = null;

            lines.forEach(line => {
                const trimmed = line.trim();
                if (!trimmed) return;

                if (trimmed.startsWith('## ')) {
                    if (currentChild) children.push(currentChild);
                    currentChild = { title: trimmed.replace(/^##\s*/, ''), items: [] };
                } else {
                    if (!currentChild) {
                        currentChild = { title: 'Nội dung bài học', items: [] };
                    }
                    
                    // Khối công thức hiển thị riêng (display math)
                    if (trimmed.startsWith('$$') && trimmed.endsWith('$$') && trimmed.length > 4) {
                        currentChild.items.push({ type: 'formula', display: true, text: trimmed.slice(2, -2).trim() });
                    } 
                    // Công thức nội dòng (inline math)
                    else if (trimmed.startsWith('$') && trimmed.endsWith('$') && trimmed.length > 2) {
                        currentChild.items.push({ type: 'formula', display: false, text: trimmed.slice(1, -1).trim() });
                    } 
                    // Hình ảnh minh họa
                    else if (/^(?:LINK\s*ẢNH|LINK\s*ANH|HÌNH\s*ẢNH|HINH\s*ANH|ẢNH|ANH)\s*[:.\-–]\s*(.*)/i.test(trimmed)) {
                        const colonIdx = trimmed.indexOf(":");
                        const url = trimmed.substring(colonIdx + 1).trim();
                        if (url) currentChild.items.push({ type: 'image', text: url });
                    } 
                    // Ghi chú quan trọng
                    else if (trimmed.startsWith('!!')) {
                        currentChild.items.push({ type: 'note', text: trimmed.replace(/^!!\s*/, '') });
                    } 
                    // Nhãn:: Nội dung chi tiết
                    else if (trimmed.includes('::')) {
                        const sep = trimmed.indexOf('::');
                        const label = trimmed.slice(0, sep).trim();
                        const text = trimmed.slice(sep + 2).trim();
                        currentChild.items.push({ label: label, text: text });
                    } 
                    // Dòng văn bản bình thường nối tiếp
                    else {
                        const last = currentChild.items[currentChild.items.length - 1];
                        if (last && !last.type && last.label === '') {
                            last.text += '\n' + trimmed;
                        } else {
                            currentChild.items.push({ label: '', text: trimmed });
                        }
                    }
                }
            });

            if (currentChild) children.push(currentChild);
            return children;
        }

        // ============================================================
        //  5. CÁC HÀM NẠP BỘ ĐỀ & LÝ THUYẾT (TỰ ĐỘNG LẤY TÊN & KHỐI TỪ AI)
        // ============================================================
        function layThongTinChungTuAiHoacMacDinh(hauToKhu) {
