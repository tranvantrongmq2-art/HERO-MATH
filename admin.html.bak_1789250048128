        // Đổi nhanh khối lớp cho bài học lý thuyết
        window.doiKhoiLopLyThuyet = async function(id, khoiMoi) {
            let ds = safeJsonParse('danh_sach_bai_hoc_ly_thuyet', []);
            const idx = ds.findIndex(x => x.id === id);
            if (idx !== -1) {
                ds[idx].grade = khoiMoi;
                ds[idx].capNhatLuc = Date.now();
                safeJsonSet('danh_sach_bai_hoc_ly_thuyet', ds);
                if (window.indexedDB) {
                    try {
                        const req = indexedDB.open('HeroMathDB', 1);
                        req.onsuccess = function(e) {
                            const db = e.target.result;
                            if (db && db.objectStoreNames && db.objectStoreNames.contains('HeroStore')) {
                                const tx = db.transaction(['HeroStore'], 'readwrite');
                                tx.objectStore('HeroStore').put(ds, 'danh_sach_bai_hoc_ly_thuyet');
                            }
                        };
                    } catch(e){}
                }
                await dongBoToanCuc('danh_sach_bai_hoc_ly_thuyet');
                try {
                    window.dispatchEvent(new StorageEvent('storage', {
                        key: 'danh_sach_bai_hoc_ly_thuyet',
                        newValue: JSON.stringify(ds)
                    }));
                } catch(e) {}
                showToast(`Đã chuyển bài học sang ${khoiMoi}!`, "success");
                hienThiDanhSachLyThuyet();
            }
        };

