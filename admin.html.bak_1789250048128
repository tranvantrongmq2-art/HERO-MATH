            try {
                let daLuuMucNao = false;

                // 1. Lưu Lý thuyết
                if (Array.isArray(ketQuaAiTatCa.ly_thuyet) && ketQuaAiTatCa.ly_thuyet.length > 0) {
                    let dsLyThuyet = safeJsonParse('danh_sach_bai_hoc_ly_thuyet', []);
