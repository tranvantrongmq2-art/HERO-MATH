    <!--  JAVASCRIPT XỬ LÝ TOÀN BỘ LOGIC HỆ THỐNG                     -->
    <!-- ============================================================ -->
    <script>
        // Bản đồ liên kết loại kho và key LocalStorage tương ứng
        const KHO_KEY_MAP = {
            trac_nghiem: 'ngan_hang_de_trac_nghiem',
            boss: 'ngan_hang_de_boss',
            vuot_ai: 'ngan_hang_de_vuot_ai',
            ly_thuyet: 'danh_sach_bai_hoc_ly_thuyet'
        };

        // Danh sách các key cấu hình và dữ liệu toàn cục
        const CAC_KEY_TOAN_CUC = [
            'math_hero_users_v2',
            'danh_sach_bai_hoc_ly_thuyet',
            'danh_sach_bai_hoc_ly_thuyet_da_xoa',
            'danh_sach_bo_de_trac_nghiem',
            'ngan_hang_de_trac_nghiem',
            'ngan_hang_de_trac_nghiem_da_xoa',
            'ngan_hang_de_boss',
            'ngan_hang_de_boss_da_xoa',
            'ngan_hang_de_vuot_ai',
            'ngan_hang_de_vuot_ai_da_xoa',
            'math_hero_marketplace',
            'math_hero_shop_items',
            'nhat_ky_dang_nhap',
            'so_luot_lam_bai_toi_da',
            'so_luot_boss_toi_da',
            'so_luot_vong_quay_toi_da',
            'so_luot_thach_dau_toi_da',
            'so_luot_vuot_ai_toi_da',
            'danh_sach_yeu_cau_quen_pass',
            'thong_tin_giao_vien_lien_he'
        ];

        // Biến tạm cho modal sửa
        let editItemLoai = null;
        let editItemId = null;

        // ============================================================
        //  1. CÁC HÀM TIỆN ÍCH AN TOÀN (SAFE UTILITIES & ERROR HANDLING)
        // ============================================================
        function safeJsonParse(key, fallback = null) {
            try {
                const val = localStorage.getItem(key);
                if (val === null || val === undefined || val === '') return fallback;
                return JSON.parse(val);
            } catch (err) {
                console.error(`[SafeJSON] Lỗi parse key "${key}":`, err);
                return fallback;
            }
        }

        function safeJsonSet(key, value) {
            try {
                localStorage.setItem(key, typeof value === 'string' ? value : JSON.stringify(value));
                return true;
            } catch (err) {
                console.error(`[SafeJSON] Lỗi lưu key "${key}":`, err);
                showToast(`Lỗi bộ nhớ: ${err.message}`, 'error');
                return false;
            }
        }

        // ============================================================
        //  1.b QUẢN LÝ API KEY AI (GEMINI) — DÙNG CHUNG TOÀN HỆ THỐNG
        //  Key lưu trong localStorage['gemini_api_key'], được napde.html
        //  và bai-tap-tu-luan.html (chấm bài AI) đọc chung.
        // ============================================================
        const GEMINI_MODEL_ADMIN = "gemini-2.0-flash";
        // Key mặc định để rỗng để đảm bảo an toàn tuyệt đối khi chia sẻ hoặc đưa lên GitHub.
        // Khi cần dùng, Thầy chỉ việc dán Key vào ô trên giao diện và bấm "Lưu Key" (lưu vào localStorage máy tính).
        const GEMINI_API_KEY_MAC_DINH = '';

        function layApiKeyGeminiAdmin() {
            let luu = (localStorage.getItem('gemini_api_key') || '').trim();
            if (!luu && GEMINI_API_KEY_MAC_DINH) {
                luu = GEMINI_API_KEY_MAC_DINH;
                localStorage.setItem('gemini_api_key', luu);
            }
            return luu;
        }

        function capNhatTrangThaiApiKeyAdmin() {
            const lbl = document.getElementById('lbl-api-key-status-admin');
            const inputKey = document.getElementById('input-admin-gemini-key');
            if (!lbl) return;
            const key = layApiKeyGeminiAdmin();
            if (key) {
                lbl.style.color = '#2ecc71';
                lbl.innerHTML = '<i class="fa-solid fa-circle-check"></i> Đã lưu Key';
            } else {
                lbl.style.color = '#e74c3c';
                lbl.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Chưa có Key';
            }
            if (inputKey && document.activeElement !== inputKey && !inputKey.value) {
                inputKey.value = key;
            }
        }

        window.toggleHienApiKeyAdmin = function () {
            const inputKey = document.getElementById('input-admin-gemini-key');
            const icon = document.getElementById('icon-admin-key-eye');
            if (!inputKey) return;
            const dangAn = inputKey.type === 'password';
            inputKey.type = dangAn ? 'text' : 'password';
            if (icon) icon.className = dangAn ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
        };

        window.luuApiKeyGeminiAdmin = function () {
            const inputKey = document.getElementById('input-admin-gemini-key');
            if (!inputKey) return;
            const key = inputKey.value.trim();
            if (!key) {
                showToast('Thầy chưa nhập API Key. Vui lòng dán Key vào ô trước khi lưu.', 'warning');
                return;
            }
            localStorage.setItem('gemini_api_key', key);
            capNhatTrangThaiApiKeyAdmin();
            showToast('Đã lưu API Key! Trang "Soạn Bằng AI" và "Bài Tập Tự Luận" sẽ tự dùng chung Key này, không cần nhập lại.', 'success');
        };

        window.xoaApiKeyGeminiAdmin = function () {
            customConfirm('Xóa API Key Gemini đã lưu? Các tính năng soạn đề / chấm bài bằng AI sẽ ngừng hoạt động cho đến khi nhập Key mới.', () => {
                localStorage.removeItem('gemini_api_key');
                const inputKey = document.getElementById('input-admin-gemini-key');
                if (inputKey) inputKey.value = '';
                capNhatTrangThaiApiKeyAdmin();
                showToast('Đã xóa API Key khỏi trình duyệt này.', 'warning');
            });
        };

        window.kiemTraApiKeyGeminiAdmin = async function () {
            const inputKey = document.getElementById('input-admin-gemini-key');
            const btnTest = document.getElementById('btn-test-key-admin');
            const key = (inputKey?.value || '').trim() || layApiKeyGeminiAdmin();
            if (!key) {
                showToast('Thầy chưa nhập API Key để kiểm tra.', 'warning');
                return;
            }
            const htmlGoc = btnTest ? btnTest.innerHTML : '';
            if (btnTest) { btnTest.disabled = true; btnTest.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang kiểm tra...'; }
            try {
                const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL_ADMIN}?key=${key}`);
                const data = await res.json();
                if (data.error) throw new Error(data.error.message || 'Key không hợp lệ');
                showToast('✅ API Key hợp lệ, kết nối Gemini thành công!', 'success');
                if (key !== layApiKeyGeminiAdmin()) {
                    localStorage.setItem('gemini_api_key', key);
                    capNhatTrangThaiApiKeyAdmin();
                }
            } catch (loi) {
                console.error('[Admin] Lỗi kiểm tra API Key:', loi);
                showToast('❌ Key không hợp lệ hoặc lỗi kết nối: ' + (loi.message || ''), 'error');
            } finally {
                if (btnTest) { btnTest.disabled = false; btnTest.innerHTML = htmlGoc; }
            }
        };

        function showToast(message, type = 'success') {
            try {
                const container = document.getElementById('toast-container');
                if (!container) return;
                const toast = document.createElement('div');
                toast.style.cssText = `
                    background: #151d30;
                    border-left: 4px solid ${type === 'success' ? '#2ecc71' : type === 'warning' ? '#f39c12' : '#e74c3c'};
                    color: #fff;
                    padding: 12px 18px;
                    border-radius: 6px;
                    box-shadow: 0 5px 18px rgba(0,0,0,0.4);
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    font-size: 0.9rem;
                    min-width: 260px;
                    max-width: 420px;
                    pointer-events: auto;
                    animation: slideIn 0.3s ease, fadeOut 0.3s ease 2.7s forwards;
                    word-break: break-word;
                `;
                const icon = type === 'success' ? 'fa-circle-check' : type === 'warning' ? 'fa-triangle-exclamation' : 'fa-circle-xmark';
                const iconColor = type === 'success' ? '#2ecc71' : type === 'warning' ? '#f39c12' : '#e74c3c';
                toast.innerHTML = `<i class="fa-solid ${icon}" style="color: ${iconColor}; font-size:1.1rem; flex-shrink:0;"></i> <span>${message}</span>`;
                container.appendChild(toast);
                setTimeout(() => { if (toast && toast.parentNode) toast.remove(); }, 3000);
            } catch (e) {
                console.warn("[showToast] Error:", e);
            }
        }

        function customConfirm(message, callback) {
            const modal = document.getElementById('custom-confirm-modal');
            const msgEl = document.getElementById('confirm-msg');
            const yesBtn = document.getElementById('confirm-yes-btn');
            const noBtn = document.getElementById('confirm-no-btn');
            if (!modal || !msgEl || !yesBtn || !noBtn) return;

            msgEl.innerText = message;
            modal.style.display = 'flex';
            
            const close = () => {
                modal.style.display = 'none';
                yesBtn.onclick = null;
            };

            yesBtn.onclick = () => {
                try { callback(); } catch (e) { console.error(e); }
                close();
            };
            noBtn.onclick = close;
        }

        function renderMath(targetElement) {
            if (window.MathJax && typeof window.MathJax.typesetPromise === "function") {
                try {
                    if (targetElement) {
                        if (typeof window.MathJax.typesetClear === "function") {
                            window.MathJax.typesetClear([targetElement]);
                        }
                        window.MathJax.typesetPromise([targetElement]).catch(err => console.warn("[MathJax] Typeset error:", err));
                    } else {
                        window.MathJax.typesetPromise().catch(err => console.warn("[MathJax] Typeset error:", err));
                    }
                } catch (e) {
                    console.warn("[MathJax] Exception:", e);
                }
            }
        }

        // ============================================================
        //  2. ĐỒNG BỘ VỚI FIREBASE (FIREBASE SYNC LAYER)
        // ============================================================
        function choFirebaseSanSang(maxWaitMs = 4000) {
            return new Promise((resolve) => {
                if (window.HeroFirebaseCompat) return resolve(window.HeroFirebaseCompat);
                if (window.FirebaseSync) return resolve(window.FirebaseSync);
                const startTime = Date.now();
                const interval = setInterval(() => {
                    if (window.HeroFirebaseCompat) {
                        clearInterval(interval);
                        resolve(window.HeroFirebaseCompat);
                    } else if (window.FirebaseSync) {
                        clearInterval(interval);
                        resolve(window.FirebaseSync);
                    } else if (Date.now() - startTime > maxWaitMs) {
                        clearInterval(interval);
                        console.warn("[Admin] Firebase chưa phản hồi trong thời gian chờ, tiếp tục với LocalStorage.");
                        resolve(null);
                    }
                }, 100);
            });
        }

        function capNhatHuyHieuSync(trangThai, text) {
            const badge = document.getElementById('sync-status-badge');
            if (!badge) return;
            badge.className = 'status-badge ' + (trangThai === 'loading' ? 'syncing' : (trangThai === true ? '' : 'offline'));
            const textHienThi = text || (trangThai === 'loading' ? 'Đang đồng bộ...' : (trangThai === true ? 'Firebase Sẵn Sàng' : 'Ngoại tuyến'));
            badge.innerHTML = `<i class="fa-solid fa-circle" style="font-size:0.6rem;"></i> <span>${textHienThi}</span>`;
        }

        async function taiVeTuFirebaseTruocKhiHienThi() {
            capNhatHuyHieuSync('loading', 'Đang nạp từ Cloud...');
