        function xuatDanhMucJson(danhMuc) {
            const timeStamp = new Date().toISOString().replace(/[:.]/g, '-');
            let data = null;
            let fileName = `hero_math_${danhMuc}_${timeStamp}.json`;

            if (danhMuc === 'trac_nghiem') {
                data = {
                    category: 'trac_nghiem',
                    key: 'ngan_hang_de_trac_nghiem',
                    items: safeJsonParse('ngan_hang_de_trac_nghiem', [])
                };
            } else if (danhMuc === 'boss') {
                data = {
                    category: 'boss',
                    key: 'ngan_hang_de_boss',
                    items: safeJsonParse('ngan_hang_de_boss', [])
                };
            } else if (danhMuc === 'vuot_ai') {
                data = {
                    category: 'vuot_ai',
                    key: 'ngan_hang_de_vuot_ai',
                    items: safeJsonParse('ngan_hang_de_vuot_ai', [])
                };
            } else if (danhMuc === 'ly_thuyet') {
                data = {
                    category: 'ly_thuyet',
                    key: 'danh_sach_bai_hoc_ly_thuyet',
                    items: safeJsonParse('danh_sach_bai_hoc_ly_thuyet', [])
                };
            } else if (danhMuc === 'hoc_sinh') {
                const studentProfiles = {};
                for (let i = 0; i < localStorage.length; i++) {
