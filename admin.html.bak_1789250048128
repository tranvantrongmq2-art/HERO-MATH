            let ngayGio = new Date().toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
            let tenBoDe = '';
            if (tenChuDeAi) {
                if (hauToKhu) {
                    tenBoDe = tenChuDeAi.toLowerCase().includes(hauToKhu.toLowerCase()) ? tenChuDeAi : `${tenChuDeAi} - ${hauToKhu}`;
