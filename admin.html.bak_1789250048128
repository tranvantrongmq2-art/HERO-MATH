                    dsBoss.unshift({
                        id: "bodeboss_" + Date.now(),
                        title: tenBoss,
                        level: "hard",
                        grade: khoi,
                        questions: ketQuaAiTatCa.boss,
                        source: "ai",
                        created_at: nowStr
                    });
                    safeJsonSet('ngan_hang_de_boss', dsBoss);
