    // Bọc hàm Xóa API Key
    const _origXoaApiKey = window.xoaApiKeyGeminiAdmin;
    window.xoaApiKeyGeminiAdmin = function() {
        if (!confirm('Thầy/Cô có chắc chắn muốn xóa Gemini API Key đã lưu không?')) return;
